local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function notify(title, content)
    Rayfield:Notify({Title = title, Content = content, Duration = 4, Image = 4483362458})
end

local function character()
    return player.Character
end

local function rootPart()
    local char = character()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
    local char = character()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getPart(object)
    if not object then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChild("HumanoidRootPart") or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return object:FindFirstAncestorWhichIsA("Model") and getPart(object:FindFirstAncestorWhichIsA("Model")) or nil
end

local function teleportTo(object, offset)
    local root = rootPart()
    local target = getPart(object)
    if not root or not target then
        notify("Teleport", "Target is not available.")
        return false
    end
    root.CFrame = target.CFrame + (offset or Vector3.new(0, 4, 0))
    return true
end

local function findPath(...)
    local node = Workspace
    for _, name in ipairs({...}) do
        node = node and node:FindFirstChild(name)
    end
    return node
end

local function findNamed(name)
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == name then return object end
    end
    return nil
end

local function stopFly()
    S.fly = false
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    local hum = humanoid()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    stopFly()
    S.fly = true
    local root = rootPart()
    local hum = humanoid()
    if not root or not hum then S.fly = false return end

    flyGyro = Instance.new("BodyGyro")
    flyGyro.P = 90000
    flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root
    hum.PlatformStand = true

    flyConnection = RunService.RenderStepped:Connect(function()
        if not S.fly or not root.Parent then stopFly() return end
        local direction = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
        flyVelocity.Velocity = direction.Magnitude > 0 and direction.Unit * S.flySpeed or Vector3.zero
        flyGyro.CFrame = camera.CFrame
    end)
end

local function destroyOverlay(key)
    local data = overlays[key]
    if not data then return end
    if data.highlight then data.highlight:Destroy() end
    if data.billboard then data.billboard:Destroy() end
    overlays[key] = nil
end

local function clearOverlays(kind)
    for key, data in pairs(overlays) do
        if not kind or data.kind == kind or not key.Parent then destroyOverlay(key) end
    end
end

local function createOverlay(object, kind, labelText, color)
    if not object or overlays[object] then return end
    local part = getPart(object)
    if not part then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "Moon_" .. kind
    highlight.Adornee = object:IsA("Model") and object or part
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    pcall(function() highlight.Parent = CoreGui end)
    if not highlight.Parent then highlight.Parent = player:WaitForChild("PlayerGui") end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MoonLabel"
    billboard.Adornee = part
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(220, 32)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    pcall(function() billboard.Parent = CoreGui end)
    if not billboard.Parent then billboard.Parent = player:WaitForChild("PlayerGui") end

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.25
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Text = labelText
    label.Parent = billboard

    overlays[object] = {kind = kind, highlight = highlight, billboard = billboard, label = label, part = part}
end

local function refreshPlayerESP()
    clearOverlays("Player")
    if not S.playerESP then return end
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            createOverlay(target.Character, "Player", target.DisplayName .. " (@" .. target.Name .. ")", Color3.fromRGB(80, 180, 255))
        end
    end
end

local function refreshNPCESP()
    clearOverlays("NPC")
    clearOverlays("Detained")
    if S.npcESP then
        local cars = Workspace:FindFirstChild("BorderRuntimeCars")
        if cars then
            for _, car in ipairs(cars:GetChildren()) do
                for _, object in ipairs(car:GetChildren()) do
                    if object:IsA("Model") and object:FindFirstChildOfClass("Humanoid") then
                        createOverlay(object, "NPC", object.Name, Color3.fromRGB(255, 210, 70))
                    end
                end
            end
        end
        local raiders = Workspace:FindFirstChild("BorderRaiders")
        if raiders then
            for _, object in ipairs(raiders:GetChildren()) do
                if object:IsA("Model") and object:FindFirstChildOfClass("Humanoid") then
                    createOverlay(object, "NPC", "Raider: " .. object.Name, Color3.fromRGB(255, 70, 70))
                end
            end
        end
    end
    if S.detainedESP then
        local detained = Workspace:FindFirstChild("BorderDetainedNPCs")
        if detained then
            for _, object in ipairs(detained:GetChildren()) do
                if object:IsA("Model") then
                    createOverlay(object, "Detained", "Detained: " .. object.Name, Color3.fromRGB(255, 120, 220))
                end
            end
        end
    end
end

local function refreshCarESP()
    clearOverlays("Car")
    if not S.carESP then return end
    local cars = Workspace:FindFirstChild("BorderRuntimeCars")
    if not cars then return end
    for _, car in ipairs(cars:GetChildren()) do
        if car:IsA("Model") then
            createOverlay(car, "Car", car.Name, Color3.fromRGB(80, 255, 150))
        end
    end
end

local function promptLabel(prompt)
    local parent = prompt.Parent
    local model = parent and parent:FindFirstAncestorWhichIsA("Model")
    local base = prompt.ActionText ~= "" and prompt.ActionText or prompt.Name
    if model then base ..= " - " .. model.Name end
    return base
end

local function refreshPromptESP()
    clearOverlays("Prompt")
    if not S.promptESP then return end
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("ProximityPrompt") and object.Enabled then
            local target = object.Parent
            if target then createOverlay(target, "Prompt", promptLabel(object), Color3.fromRGB(180, 120, 255)) end
        end
    end
end

local function applyPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if not promptOriginals[prompt] then
        promptOriginals[prompt] = {
            distance = prompt.MaxActivationDistance,
            hold = prompt.HoldDuration,
            sight = prompt.RequiresLineOfSight,
        }
    end
    local original = promptOriginals[prompt]
    prompt.MaxActivationDistance = S.extendedPrompts and 35 or original.distance
    prompt.RequiresLineOfSight = S.extendedPrompts and false or original.sight
    prompt.HoldDuration = S.instantPrompts and 0 or original.hold
end

local function refreshPrompts()
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("ProximityPrompt") then applyPrompt(object) end
    end
end

local function nearestCar()
    local root = rootPart()
    local cars = Workspace:FindFirstChild("BorderRuntimeCars")
    if not root or not cars then return nil end
    local best, distance
    for _, car in ipairs(cars:GetChildren()) do
        local part = getPart(car)
        if part then
            local current = (part.Position - root.Position).Magnitude
            if not distance or current < distance then best, distance = car, current end
        end
    end
    return best, distance
end

local function nearestPrompt()
    local root = rootPart()
    if not root then return nil end
    local best, distance
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local part = getPart(prompt.Parent)
            if part then
                local current = (part.Position - root.Position).Magnitude
                if not distance or current < distance then best, distance = prompt, current end
            end
        end
    end
    return best, distance
end

connect(RunService.RenderStepped, function()
    local hum = humanoid()
    if hum then
        if S.walkSpeedEnabled then hum.WalkSpeed = S.walkSpeed end
        if S.jumpEnabled then hum.UseJumpPower = true; hum.JumpPower = S.jumpPower end
    end
end)

connect(RunService.Stepped, function()
    local char = character()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollision[part] == nil then originalCollision[part] = part.CanCollide end
            if S.noclip then part.CanCollide = false end
        end
    end
end)

